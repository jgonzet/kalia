# Optional overrides. Copy to .env, uncomment a line and set a value to change its default.
# Defaults live in app/config.py (in the Dockerfile for LLM_BASE_URL and SAMPLE_COMPANY, in compose.yaml for DB_PATH).
# Leave a variable commented out to keep its default; an empty value is not the same as unset in Docker.

# --- LLM ---
# The default LLM, used by every task that has no LLM of its own (see "One LLM per task" below).

# Which backend talks to the LLM: "ollama" (default, Ollama's native API), "anthropic" (the Claude API),
# "openai_compatible" (any endpoint that speaks the OpenAI API, at /v1) or "fake" (a fixed text, used by the smoke test and CI).
# LLM_BACKEND=

# The model. "ollama" has a default (qwen2.5:14b); "anthropic" and "openai_compatible" need one: the app refuses to start without it.
# LLM_MODEL=

# The server address. The server root for "ollama" (default http://localhost:11434), the /v1 address for "openai_compatible".
# "anthropic" ignores it: it always talks to Anthropic's own address (the Docker image sets this variable for Ollama).
# LLM_BASE_URL=

# The context window in tokens. With "ollama" it is asked of the server on every request and the app answers with
# the list of commitments, without the LLM, when a prompt would not fit. Default 10240, what a 12 GB GPU runs for
# qwen2.5:14b without using the CPU. With "anthropic" and "openai_compatible" there is no default and no check unless you set it.
# LLM_CONTEXT_TOKENS=

# Seconds one attempt at a call waits for the answer (default 120). The longest answer of a local model on a GPU took 72 seconds
# (README, "Known limitations"); raise it for a slower machine or a model that runs on the CPU. The clients of "openai_compatible"
# and "anthropic" retry a failed call twice more, so one call can take about three times this.
# LLM_TIMEOUT_SECONDS=

# The API key of "anthropic" and "openai_compatible" is a secret: it goes in .env.secrets (see .env.secrets.example), never here.
# "openai_compatible" always needs one; for a local server that checks no key, any text will do.

# --- One LLM per task ---
# Each task that calls an LLM (extractor: reads the documents; answerer: writes the chat answers) can use its own, with the
# same variables as above and the prefix of the task: EXTRACTOR_LLM_BACKEND, EXTRACTOR_LLM_MODEL, EXTRACTOR_LLM_BASE_URL,
# EXTRACTOR_LLM_CONTEXT_TOKENS, EXTRACTOR_LLM_TIMEOUT_SECONDS and, in .env.secrets, EXTRACTOR_LLM_API_KEY; the same with ANSWERER_ for the answerer.
# - A task with none of its variables uses the default LLM above.
# - A task with any of them takes everything from its own: it inherits nothing from the default. The backend is required, and
#   so are the model and the key for "anthropic" and "openai_compatible"; if one is missing, the app refuses to start and says which.
# - In Docker, the image points LLM_BASE_URL at the Ollama of the host; a task does not inherit it, so a task that uses
#   Ollama there needs its own address (EXTRACTOR_LLM_BASE_URL=http://host.docker.internal:11434).
# - A variable written like these but that the app does not read (EXTRATOR_LLM_BACKEND, EXTRACTOR_LLM_MODLE) makes the app
#   refuse to start, so a typo is not silently ignored.
# Example, the extractor with Claude and the chat with Ollama (the key goes in .env.secrets as EXTRACTOR_LLM_API_KEY):
# EXTRACTOR_LLM_BACKEND=anthropic
# EXTRACTOR_LLM_MODEL=
# EXTRACTOR_LLM_BASE_URL=
# EXTRACTOR_LLM_CONTEXT_TOKENS=
# EXTRACTOR_LLM_TIMEOUT_SECONDS=
# ANSWERER_LLM_BACKEND=
# ANSWERER_LLM_MODEL=
# ANSWERER_LLM_BASE_URL=
# ANSWERER_LLM_CONTEXT_TOKENS=
# ANSWERER_LLM_TIMEOUT_SECONDS=

# The date the app treats as "today" (YYYY-MM-DD). Unset means the system date.
# For the synthetic dataset use the reference_date of data/<company>/company.json.
# REFERENCE_DATE=

# SQLite file path. Docker compose sets it inside the container; only change it outside Docker.
# DB_PATH=

# Sample company the app loads at startup when its database does not hold it yet (a folder under data/). The Docker image sets it
# to lamanija; outside Docker it is unset and nothing is loaded. When set, "today" is REFERENCE_DATE if you set it,
# else the reference_date of the sample's company.json, else the system date.
# SAMPLE_COMPANY=

# Where the commitments of the sample come from. The first line is the default:
#   expected   = the ones written in data/<company>/expected/, no LLM, ready at once
#   extraction = the sample documents go through your LLM at startup: the chat waits until it ends and, since nothing
#                is kept between runs, it repeats on every `docker compose up`; an API is paid each time
# COMMITMENTS_SOURCE=expected
# COMMITMENTS_SOURCE=extraction

# Owner of every stored record (V0 has a single owner).
# OWNER_ID=
