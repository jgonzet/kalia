# Copy this file to .env.secrets, uncomment the lines you need and fill in the values. .env.secrets is git-ignored: never commit it.
# The rest of the LLM settings (backend, model, ...) go in .env, see .env.example.

# API key of the default LLM. Needed with LLM_BACKEND=anthropic or openai_compatible (for a local server that checks no key, any text will do); not with Ollama.
# LLM_API_KEY=

# API keys of a task that has its own LLM (EXTRACTOR_LLM_* / ANSWERER_LLM_* in .env). A task with its own LLM needs its own key:
# it does not use LLM_API_KEY.
# EXTRACTOR_LLM_API_KEY=
# ANSWERER_LLM_API_KEY=
